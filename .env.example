# Copy to .env and fill in the providers you want to use. Leave a key empty to disable that provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Any OpenAI-compatible host works here (Groq, Together, DeepSeek, ...)
OPENAI_BASE_URL=https://api.openai.com/v1
# Local models: run `ollama serve`, then set this (leave unset to disable Ollama)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Model list with prices and capabilities, and where requests are logged
TIERWISE_REGISTRY=config/registry.yaml
TIERWISE_DB_URL=sqlite+aiosqlite:///tierwise.db

# Reliability (defaults shown)
# RETRIES=2
# BREAKER_FAILURES=5
# BREAKER_WINDOW_S=60
# BREAKER_COOLDOWN_S=30
# STREAM_HOLD_S=3.0
# STREAM_HOLD_BYTES=4096

# Semantic cache (needs models/router/model.onnx)
# TIERWISE_CACHE=false   (opt-in: see the README's limits)
# CACHE_SIMILARITY=0.95
# CACHE_TTL_S=3600
# CACHE_MAX_ENTRIES=10000
# CACHE_MAX_TEMPERATURE=0.3

# Gateway API keys (create with `tierwise keys create`)
# TIERWISE_REQUIRE_KEY=false
# KEYS_REFRESH_S=30
