# Copy to .env and fill in the providers you want to use. Leave a key empty to disable that provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Any OpenAI-compatible host works here (Groq, Together, DeepSeek, ...)
OPENAI_BASE_URL=https://api.openai.com/v1
# Local models: run `ollama serve`, then set this (leave unset to disable Ollama)
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Model list with prices and capabilities, and where requests are logged
TIERWISE_REGISTRY=config/registry.yaml
TIERWISE_DB_URL=sqlite+aiosqlite:///tierwise.db

# Server (defaults shown)
# TIERWISE_HOST=127.0.0.1
# TIERWISE_PORT=8000

# Learned router (defaults shown; unset TIERWISE_ROUTER_DIR uses models/router, then the packaged copy)
# TIERWISE_LEARNED_ROUTER=true
# TIERWISE_ROUTER_DIR=models/router
# ROUTER_THREADS=2
# ROUTER_PROVIDER=CPUExecutionProvider

# Reliability (defaults shown)
# RETRIES=2
# RETRY_BASE_S=0.25
# RETRY_MAX_S=2.0
# BREAKER_FAILURES=5
# BREAKER_WINDOW_S=60
# BREAKER_COOLDOWN_S=30
# STREAM_HOLD_S=3.0
# STREAM_HOLD_BYTES=4096

# Semantic cache (needs models/router/model.onnx)
# TIERWISE_CACHE=false   (opt-in: see the README's limits)
# CACHE_SIMILARITY=0.95
# CACHE_TTL_S=3600
# CACHE_MAX_ENTRIES=10000
# CACHE_MAX_TEMPERATURE=0.3

# Gateway API keys (create with `tierwise keys create`)
# TIERWISE_REQUIRE_KEY=false
# KEYS_REFRESH_S=30

# Tracing: send OpenTelemetry spans to an OTLP/HTTP collector (unset: no tracing)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Data flywheel (all off by default: see the README's "Data flywheel" section)
# TIERWISE_STORE_PAYLOADS=false
# TIERWISE_SHADOW_RATE=0.02
# TIERWISE_SHADOW_BUDGET_USD=5.0
# TIERWISE_JUDGE_MODEL=        (unset: the registry's baseline_model)
